{
  "info": {
    "_postman_id": "6f2a1c3d-8b4e-4a7f-9c2d-1e5f7a3b9d10",
    "name": "AI Gateway - Model Capabilities",
    "description": "Exercises the model-facing POST endpoints (/chat, /complete, /vision, /embeddings, /model/:alias) across their capabilities and usage modes: single-turn, multi-turn, streaming SSE, vision with image_url and inline base64 image_data, embeddings with single/batch input, auto:* routing aliases, and common error paths. Requires an app key created via the Admin collection with capabilities enabled for chat, complete, vision and embeddings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{APP_KEY}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat - Single turn (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('response has text/provider/model', function () {",
                  "  pm.expect(typeof body.text).to.eql('string');",
                  "  pm.expect(typeof body.provider).to.eql('string');",
                  "  pm.expect(typeof body.model).to.eql('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{MODEL_CHAT_PRIMARY}}\",\n  \"stream\": false,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hello in one short sentence.\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/chat",
              "host": ["{{BASE_URL}}"],
              "path": ["chat"]
            },
            "description": "Single-turn, non-streaming chat call returning a JSON ChatResponse."
          }
        },
        {
          "name": "Chat - Multi-turn with system prompt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('response has text', function () {",
                  "  pm.expect(typeof body.text).to.eql('string');",
                  "  pm.expect(body.text.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{MODEL_CHAT_PRIMARY}}\",\n  \"stream\": false,\n  \"temperature\": 0.2,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a concise assistant. Answer in at most one sentence.\" },\n    { \"role\": \"user\", \"content\": \"What is the capital of France?\" },\n    { \"role\": \"assistant\", \"content\": \"The capital of France is Paris.\" },\n    { \"role\": \"user\", \"content\": \"And the capital of Italy?\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/chat",
              "host": ["{{BASE_URL}}"],
              "path": ["chat"]
            },
            "description": "Multi-turn conversation with a system prompt and prior assistant turn, non-streaming."
          }
        },
        {
          "name": "Chat - Streaming (SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('content-type is text/event-stream', function () {",
                  "  const ct = pm.response.headers.get('Content-Type') || '';",
                  "  pm.expect(ct).to.include('text/event-stream');",
                  "});",
                  "pm.test('stream contains meta and done events', function () {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.include('event: meta');",
                  "  pm.expect(text).to.include('event: done');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{MODEL_CHAT_PRIMARY}}\",\n  \"stream\": true,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Count from one to five, one number per line.\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/chat",
              "host": ["{{BASE_URL}}"],
              "path": ["chat"]
            },
            "description": "Streaming chat call; expects an SSE response with meta/delta/done events."
          }
        },
        {
          "name": "Chat - auto:balanced routing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('resolved provider/model reported', function () {",
                  "  pm.expect(typeof body.provider).to.eql('string');",
                  "  pm.expect(typeof body.model).to.eql('string');",
                  "});"
