              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"auto:balanced\",\n  \"stream\": false,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"In one sentence, what is an AI gateway?\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{BASE_URL}}/chat",
              "host": ["{{BASE_URL}}"],
              "path": ["chat"]
            },
            "description": "Uses the auto:balanced routing alias, which falls back across providers until one is available."
          }
        }
      ]
    },
